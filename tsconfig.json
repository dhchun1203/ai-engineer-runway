{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // remark-cloze-blanks.ts는 명시적 `.ts` 확장자로 cloze-key.ts를 import한다 —
    // Node의 네이티브 타입 스트리핑(게이트의 pathToFileURL 동적 import,
    // scripts/e2e-cloze.mjs)이 상대 경로 지정자에 확장자를 요구하기 때문이다.
    // noEmit이 이미 true라 이 플래그를 켜도 산출물에 영향이 없다(Rule 3, 빌드
    // 타입체크 차단 해소).
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "#site/content": ["./.velite"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
